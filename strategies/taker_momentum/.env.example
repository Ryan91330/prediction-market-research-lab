# Example environment file for the taker-momentum strategy.
# Copy to .env and fill in real values for a live/paper deployment. NEVER commit a real .env file.
# All numeric defaults baked into config.py are illustrative placeholders, not production tuning values —
# see README.md. Values below are placeholders too.

# --- Polymarket CLOB credentials (required unless DRY_RUN=1) ---
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_FUNDER=0xYOUR_POLYMARKET_PROXY_OR_SAFE_ADDRESS
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
# 0=EOA | 1=POLY_PROXY | 2=POLY_GNOSIS_SAFE (default) | 3=POLY_1271
POLYMARKET_SIGNATURE_TYPE=2

# --- Run mode ---
ASSET=btc
# ASSETS=btc,eth,xrp        # used by launch.py to run several assets as separate processes
DRY_RUN=1                    # 1 = paper mode, no real orders sent

# --- Signal ---
ZDIR=1.5
USE_TICKS=0
MIN_RET=0.0004

# --- Sizing / exposure ---
SIZE_PCT=0.02
MAX_TK=1
MAX_ATTEMPTS=6
MAX_EXPOSURE_PCT=0.10
VOL_SIZE_MULT=1.0
VOL_SIGMA_HI=0.0001
SCORE_SIZING=1,1,1,1
SCORE_ACCEL=0.5
SCORE_AGE=10
SCORE_IMB=0.0
STALE_BOOST=1.0
STALE_WIN_S=4

# --- Entry guardrails ---
MIN_PRICE_TK=0.15
MAX_PRICE_TK=0.60
ENTRY_LO_TK=10
ACCEL_MIN=0
LOCK_DIR=1
XDIR_LEADER=
NCROSS_MAX=-1
TRADE_HOURS_UTC=

# --- Entry gate (fair-value cap) ---
CAP_MODE=fair
CAP_MARGIN=0.07
CAP_MARGIN_LO=0
CAP_MARGIN_HI=0
WINPROB_FLOOR=0
WINPROB_CEIL=-1

# --- Lead-ratio filter ---
LEADRATIO_LOG=1
LEADRATIO_FILTER=1
LEADRATIO_ASSETS=
LEADRATIO_WIN_S=10
LEADRATIO_DEC=0.05
LEADRATIO_RHI=0.75

# --- Order execution / limit pricing ---
LIMIT_MODE=fair
FILL_MARGIN=0.03
TAKER_SLIP=0.04
MAX_WALK=0
EF_WALK=-1
ADD_GAP_TK=3
CLOB_KEEPALIVE_S=3.0

# --- Near-tie exit overlay ---
EXIT_NEARTIE=1
EXIT_ASSETS=
EXIT_TAU_S=20
EXIT_MODE=buyopp
EXIT_SELL_SLIP=0.05
EXIT_MIN_SELL=0.03
EXIT_BUY_SLIP=0.05
EXIT_LOCKWIN=breaker
EXIT_LOCKWIN_MAXP=0.30
EXIT_NEAR_BP=8

# --- Near-tie regime-duration breaker ---
REGIME_BREAKER=1
RB_NEAR_BP=10
RB_WIN=10
RB_THR_ON=0.5
RB_ARM_SLOTS=24
RB_THR_OFF=0.3
RB_DISARM_SLOTS=6
RB_WARMBOOT=1

# --- Early-fire (tick-based early signal injection) ---
EARLY_FIRE=-1
EF_K=1.8
EF_PERSIST=0.2

# --- Event loop / execution engineering (structural, safe to leave as-is) ---
LOOP_S=0.5
EVENT_DRIVEN=1
EVENT_DEBOUNCE_S=0
CONFIRM_S=0.5
CONFIRM_MAX=2.5
LAT_LOG=1
NET_TIMEOUT_S=3.0
BOOK_TTL_S=5.0
SIGNAL_TTL_S=2.5
DOWN_BOOK_ASK=1
LOCAL_1S_SHADOW=0

# --- Logging ---
STATE_TAG=

# --- Multi-asset launcher (launch.py only) ---
LAUNCH_STAGGER_S=2.0
LAUNCH_GRACE_S=25
